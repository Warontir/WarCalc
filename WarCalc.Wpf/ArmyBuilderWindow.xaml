<Window x:Class="WarCalc.Wpf.ArmyBuilderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Army builder" Height="640" Width="980" WindowStartupLocation="CenterOwner" Loaded="Window_Loaded">
    <Grid Margin="10">
        <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

        
        <DockPanel Margin="0,0,10,0">
            <StackPanel DockPanel.Dock="Bottom" x:Name="Form" Margin="0,8,0,0">
                <TextBlock Text="Name"/>
                <TextBox Text="{Binding Name}"/>
                <TextBlock Text="Faction" Margin="0,6,0,0"/>
                <ComboBox x:Name="FactionBox" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding FactionId}"/>
                <TextBlock Text="Points limit" Margin="0,6,0,0"/>
                <TextBox Text="{Binding PointsLimit}"/>
                <UniformGrid Columns="3" Margin="0,8,0,0">
                    <Button Content="New" Click="NewArmy_Click"/>
                    <Button Content="Save" Click="SaveArmy_Click"/>
                    <Button Content="Delete" Click="DeleteArmy_Click"/>
                </UniformGrid>
            </StackPanel>
            <GroupBox Header="Armies">
                <ListBox x:Name="ArmyList" DisplayMemberPath="Name" SelectionChanged="ArmyList_SelectionChanged" BorderThickness="0"/>
            </GroupBox>
        </DockPanel>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="SummaryText" Text="Select or create an army" FontSize="16" FontWeight="Bold" Margin="0,0,0,6"/>

            <GroupBox Grid.Row="1" Header="Units in army">
                <DataGrid x:Name="LineGrid" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Unit" Binding="{Binding UnitName}" Width="*"/>
                        <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}"/>
                        <DataGridTextColumn Header="Pts each" Binding="{Binding PointsEach}"/>
                        <DataGridTextColumn Header="Total" Binding="{Binding LineTotal}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
            <Button Grid.Row="2" Content="Remove selected unit" Click="Remove_Click" HorizontalAlignment="Left"/>

            <GroupBox Grid.Row="3" Header="Available units (army's faction)">
                <DataGrid x:Name="AvailableGrid" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Unit" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Models" Binding="{Binding ModelCount}"/>
                        <DataGridTextColumn Header="Pts" Binding="{Binding Points}"/>
                        <DataGridTextColumn Header="T" Binding="{Binding Toughness}"/>
                        <DataGridTextColumn Header="Sv" Binding="{Binding Save}"/>
                        <DataGridTextColumn Header="W" Binding="{Binding Wounds}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
            <StackPanel Grid.Row="4" Orientation="Horizontal">
                <TextBlock Text="Quantity:" VerticalAlignment="Center"/>
                <TextBox x:Name="QtyBox" Width="40" Text="1"/>
                <Button Content="Add to army" Click="Add_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
