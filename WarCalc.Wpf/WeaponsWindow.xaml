<Window x:Class="WarCalc.Wpf.WeaponsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Weapons" Height="560" Width="860" WindowStartupLocation="CenterOwner" Loaded="Window_Loaded">
    <Grid Margin="10">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>

        <DockPanel Margin="0,0,10,0">
            <GroupBox DockPanel.Dock="Bottom" Header="Damage calculator (select a weapon above)" Margin="0,8,0,0" Padding="6">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Target:" VerticalAlignment="Center"/>
                        <ComboBox x:Name="TargetBox" Width="200" DisplayMemberPath="Name" SelectedValuePath="Id"/>
                        <TextBlock Text="Models firing:" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        <TextBox x:Name="AttackersBox" Width="40" Text="1"/>
                        <Button Content="Calculate" Click="Calc_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="ResultText" Margin="2,8,0,0" FontFamily="Consolas" TextWrapping="Wrap"/>
                </StackPanel>
            </GroupBox>
            <DataGrid x:Name="WeaponGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="WeaponGrid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="Range" Binding="{Binding RangeInches}"/>
                    <DataGridTextColumn Header="A" Binding="{Binding Attacks}"/>
                    <DataGridTextColumn Header="BS/WS" Binding="{Binding Skill}"/>
                    <DataGridTextColumn Header="S" Binding="{Binding Strength}"/>
                    <DataGridTextColumn Header="AP" Binding="{Binding Ap}"/>
                    <DataGridTextColumn Header="D" Binding="{Binding Damage}"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <StackPanel Grid.Column="1" x:Name="Form">
            <UniformGrid Columns="2">
                <UniformGrid.Resources>
                    <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/></Style>
                </UniformGrid.Resources>
                <TextBlock Text="Name"/><TextBox Text="{Binding Name}"/>
                <TextBlock Text="Range (0 = melee)"/><TextBox Text="{Binding RangeInches}"/>
                <TextBlock Text="Attacks (avg)"/><TextBox Text="{Binding Attacks}"/>
                <TextBlock Text="BS/WS (3 = 3+)"/><TextBox Text="{Binding Skill}"/>
                <TextBlock Text="Strength"/><TextBox Text="{Binding Strength}"/>
                <TextBlock Text="AP (-2 = 2)"/><TextBox Text="{Binding Ap}"/>
                <TextBlock Text="Damage (avg)"/><TextBox Text="{Binding Damage}"/>
            </UniformGrid>
            <UniformGrid Columns="3" Margin="0,10,0,0">
                <Button Content="New" Click="New_Click"/>
                <Button Content="Save" Click="Save_Click"/>
                <Button Content="Delete" Click="Delete_Click"/>
            </UniformGrid>
            <TextBlock Text="Averages: D6 = 3.5, D3 = 2, D6+1 = 4.5" Foreground="Gray" Margin="2,10,0,0" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</Window>
