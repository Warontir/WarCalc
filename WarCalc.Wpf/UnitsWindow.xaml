<Window x:Class="WarCalc.Wpf.UnitsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Units" Height="520" Width="860" WindowStartupLocation="CenterOwner" Loaded="Window_Loaded">
    <Grid Margin="10">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>

        <DockPanel Margin="0,0,10,0">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                <ComboBox x:Name="FilterFaction" Width="160" DisplayMemberPath="Name" SelectedValuePath="Id"/>
                <TextBox x:Name="SearchBox" Width="160" ToolTip="Name contains..."/>
                <Button Content="Search" Click="Search_Click"/>
            </StackPanel>
            <DataGrid x:Name="UnitGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="UnitGrid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="Models" Binding="{Binding ModelCount}"/>
                    <DataGridTextColumn Header="Pts" Binding="{Binding Points}"/>
                    <DataGridTextColumn Header="T" Binding="{Binding Toughness}"/>
                    <DataGridTextColumn Header="Sv" Binding="{Binding Save}"/>
                    <DataGridTextColumn Header="W" Binding="{Binding Wounds}"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <StackPanel Grid.Column="1" x:Name="Form">
            <UniformGrid Columns="2">
                <UniformGrid.Resources>
                    <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/></Style>
                </UniformGrid.Resources>
                <TextBlock Text="Name"/><TextBox Text="{Binding Name}"/>
                <TextBlock Text="Faction"/>
                <ComboBox x:Name="FormFaction" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding FactionId}"/>
                <TextBlock Text="Models"/><TextBox Text="{Binding ModelCount}"/>
                <TextBlock Text="Points"/><TextBox Text="{Binding Points}"/>
                <TextBlock Text="Move (in)"/><TextBox Text="{Binding Move}"/>
                <TextBlock Text="Toughness"/><TextBox Text="{Binding Toughness}"/>
                <TextBlock Text="Save (3 = 3+)"/><TextBox Text="{Binding Save}"/>
                <TextBlock Text="Invuln (blank = none)"/><TextBox Text="{Binding InvulnerableSave}"/>
                <TextBlock Text="Wounds"/><TextBox Text="{Binding Wounds}"/>
                <TextBlock Text="Leadership"/><TextBox Text="{Binding Leadership}"/>
                <TextBlock Text="Objective control"/><TextBox Text="{Binding ObjectiveControl}"/>
            </UniformGrid>
            <UniformGrid Columns="3" Margin="0,10,0,0">
                <Button Content="New" Click="New_Click"/>
                <Button Content="Save" Click="Save_Click"/>
                <Button Content="Delete" Click="Delete_Click"/>
            </UniformGrid>
            <Button Content="Weapons &amp; damage calculator..." Click="Weapons_Click"/>
        </StackPanel>
    </Grid>
</Window>
