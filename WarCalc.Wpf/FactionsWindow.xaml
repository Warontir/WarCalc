<Window x:Class="WarCalc.Wpf.FactionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Factions" Height="380" Width="680" WindowStartupLocation="CenterOwner" Loaded="Window_Loaded">
    <Grid Margin="10">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="230"/></Grid.ColumnDefinitions>

        <DataGrid x:Name="FactionGrid" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,0,10,0"
                  SelectionChanged="FactionGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="150"/>
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Column="1" x:Name="Form">
            <TextBlock Text="Name"/>
            <TextBox Text="{Binding Name}"/>
            <TextBlock Text="Description" Margin="0,8,0,0"/>
            <TextBox Text="{Binding Description}" Height="90" TextWrapping="Wrap" AcceptsReturn="True"/>
            <Button Content="New" Click="New_Click" Margin="2,14,2,2"/>
            <Button Content="Save" Click="Save_Click"/>
            <Button Content="Delete" Click="Delete_Click"/>
        </StackPanel>
    </Grid>
</Window>
